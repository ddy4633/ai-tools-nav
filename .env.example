# Supabase 配置
# 在 https://app.supabase.com 创建项目后获取
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 站点配置
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GITHUB_URL=https://github.com/ddy4633/ai-tools-nav
# NEXT_PUBLIC_X_URL=https://x.com/your-brand
NEXT_PUBLIC_CONTACT_EMAIL=hello@poph163.com

# 搜索引擎站长平台验证（可选，不配置则不会输出占位 meta）
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BAIDU_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# 可选：分析工具
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# NEXT_PUBLIC_BAIDU_TONGJI_ID=

# 可选：第三方 API
# OPENAI_API_KEY=
# GITHUB_TOKEN=

# Dokploy 部署配置（可选）
# DOKPLOY_WEBHOOK_URL=

# 商业化 / 变现（可选）
# NEWSLETTER_PROVIDER=noop
# NEWSLETTER_WEBHOOK_URL=
# NEWSLETTER_BUTTONDOWN_API_KEY=
# ANALYTICS_WEBHOOK_URL=

# 赞助位 / 商务合作（可选）
# NEXT_PUBLIC_SPONSORED_TOOL_IDS=chatgpt,claude
# SUBMISSIONS_PROVIDER=noop
# SUBMISSIONS_WEBHOOK_URL=
